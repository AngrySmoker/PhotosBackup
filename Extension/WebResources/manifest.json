{
  "manifest_version": 3,
  "name": "Photos Backup Connect",
  "version": "0.1.0",
  "description": "Securely connect your Google Photos account to the Photos Backup app.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://accounts.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["cookies", "nativeMessaging", "activeTab"],
  "host_permissions": ["https://accounts.google.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Photos Backup Connect",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  }
}
